# Devmark AI - variables de entorno (copia a .env y rellena; NUNCA subas .env al repo)

# --- Key heredada (primera versión). Sigue funcionando durante la migración. ---
DEVmark_API_KEY=changeme
LEGACY_API_KEY_ENABLED=true

# --- Base de datos (Supabase Session pooler o PostgreSQL propio) ---
# Recomendado: python -m app.cli setup-env  (la escribe por ti sin mostrar la contraseña)
# DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@HOST:5432/postgres?sslmode=require
# Secreto para el hash de las API keys (>= 32 caracteres). Si se pierde, todas las keys dejan de funcionar.
# API_KEY_PEPPER=

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2:1b
# ALLOWED_MODELS=llama3.2:1b,qwen2.5:0.5b
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_TIMEOUT_SECONDS=120

# --- API pública ---
CHAT_REQUIRE_API_KEY=false
ENABLE_DOCS=false
MAX_MESSAGES=100
MAX_INPUT_CHARS=48000

# --- Dashboard ---
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
DASHBOARD_TIMEZONE=America/Lima
PUBLIC_BASE_URL=https://ai.devmarkpe.com

# --- Logs: guardar contenido de prompts/respuestas (desactivado por privacidad) ---
LOG_REQUEST_CONTENT=false
